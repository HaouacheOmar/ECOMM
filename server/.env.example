# Copy to server/.env and adjust. Defaults match docker-compose.yml.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_ORIGIN=http://localhost:5173
DB_NAME=eshop
DB_USER=eshop
DB_PASSWORD=eshop
DB_HOST=localhost
DB_PORT=5433
REDIS_URL=redis://localhost:6379/0

# 1 enables the "Try as ..." logins and simulated activity (run `manage.py seed_demo` first).
DEMO_MODE=0

# Hosting only (see README "Deploy"): Supabase needs DB_SSLMODE=require; CELERY_EAGER=1 runs tasks
# inline when there's no worker; S3_* point media at a public Supabase Storage bucket.
# DB_SSLMODE=require
# CELERY_EAGER=1
# S3_BUCKET=media
# S3_ENDPOINT=https://<ref>.supabase.co/storage/v1/s3
# S3_REGION=<region>
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PUBLIC_URL=https://<ref>.supabase.co/storage/v1/object/public/media
