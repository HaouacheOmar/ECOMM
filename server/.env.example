# Copy to server/.env and adjust. Defaults match docker-compose.yml.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_ORIGIN=http://localhost:5173
DB_NAME=eshop
DB_USER=eshop
DB_PASSWORD=eshop
DB_HOST=localhost
DB_PORT=5433
REDIS_URL=redis://localhost:6379/0

# 1 enables the "Try as ..." logins and simulated activity (run `manage.py seed_demo` first).
DEMO_MODE=0
